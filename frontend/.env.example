# Copy to .env.local for local work, or set these in Vercel (Project Settings, Environment Variables). NEXT_PUBLIC_ values are baked into the browser bundle at build time.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# optional: full WebSocket URL if it differs from the API URL, for example wss://your-name-signbridge-api.hf.space/ws/predict
# NEXT_PUBLIC_WS_URL=
# public deployment: hide the Record sign tab
# NEXT_PUBLIC_DISABLE_RECORDING=1
# build time only, never NEXT_PUBLIC_: private Hugging Face repository holding animations/*.json and avatar/signer.glb
# SIGNBRIDGE_ASSETS_REPO=your-name/signbridge-assets
# HF_TOKEN=
