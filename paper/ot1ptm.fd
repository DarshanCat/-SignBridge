% Font definitions for OT1/ptm (Times), the same mapping as the PSNFSS ot1ptm.fd, written here because this MiKTeX installation has the
% Times font metrics and Type 1 fonts but not the PSNFSS definition files and cannot download them. Remove this file if PSNFSS is installed.
\ProvidesFile{ot1ptm.fd}[2001/06/04 font definitions for OT1/ptm.]
\DeclareFontFamily{OT1}{ptm}{\hyphenchar \font45 }
\DeclareFontShape{OT1}{ptm}{m}{n}{<-> ptmr7t}{}
\DeclareFontShape{OT1}{ptm}{m}{sl}{<-> ptmro7t}{}
\DeclareFontShape{OT1}{ptm}{m}{it}{<-> ptmri7t}{}
\DeclareFontShape{OT1}{ptm}{m}{sc}{<-> ptmrc7t}{}
\DeclareFontShape{OT1}{ptm}{b}{n}{<-> ptmb7t}{}
\DeclareFontShape{OT1}{ptm}{b}{it}{<-> ptmbi7t}{}
\DeclareFontShape{OT1}{ptm}{b}{sl}{<->ssub * ptm/b/it}{}
\DeclareFontShape{OT1}{ptm}{bx}{n}{<->ssub * ptm/b/n}{}
\DeclareFontShape{OT1}{ptm}{bx}{it}{<->ssub * ptm/b/it}{}
\DeclareFontShape{OT1}{ptm}{bx}{sl}{<->ssub * ptm/b/it}{}
\DeclareFontShape{OT1}{ptm}{m}{ui}{<->ssub * ptm/m/it}{}
\DeclareFontShape{OT1}{ptm}{b}{ui}{<->ssub * ptm/b/it}{}
\DeclareFontShape{OT1}{ptm}{bx}{ui}{<->ssub * ptm/b/it}{}
\endinput
