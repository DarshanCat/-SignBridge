# Backend (copy to backend/.env). No secrets are used anywhere in this project.
SIGNBRIDGE_CORS_ORIGINS=["http://localhost:3000"]
SIGNBRIDGE_MIN_CONFIDENCE=0.5
SIGNBRIDGE_MAX_BODY_BYTES=2000000
SIGNBRIDGE_SPACY_MODEL=en_core_web_sm
# Optional path overrides (defaults shown are relative to backend/):
# SIGNBRIDGE_MODEL_DIR=models
# SIGNBRIDGE_ANIMATION_DIR=../frontend/public/animations
# SIGNBRIDGE_TRANSLATION_CONFIG=config/translation.json
# SIGNBRIDGE_SIGN_REGISTRY=config/sign_registry.json
# SIGNBRIDGE_GLOSS_DICTIONARY=config/gloss_dictionary.json

# Frontend (copy to frontend/.env.local). Baked into the bundle at build time.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
